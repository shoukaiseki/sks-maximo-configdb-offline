<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>build\sks_configdb.jar</jar>
  <outfile>sks_configdb.exe</outfile>
  <errTitle>sks_configdb</errTitle>
  <cmdLine></cmdLine>
  <chdir></chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/</downloadUrl>
  <supportUrl></supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>images\icon.ico</icon>
  <classPath>
    <mainClass>ConfigDBUI</mainClass>
    <cp>bin</cp>
    <cp>lib\snakeyaml-2.5.jar</cp>
    <cp>maximo\lib\db2jcc.jar</cp>
    <cp>maximo\lib\db2jcc_license_cu.jar</cp>
    <cp>maximo\lib\icu4j.jar</cp>
    <cp>maximo\lib\j2ee.jar</cp>
    <cp>maximo\lib\javax.mail-api-1.6.2.jar</cp>
    <cp>maximo\lib\log4j-core-2.25.3.jar</cp>
    <cp>maximo\lib\log4j-api-2.25.3.jar</cp>
    <cp>maximo\lib\log4j-1.2-api-2.25.3.jar</cp>
    <cp>maximo\properties</cp>
    <cp>maximo\resources</cp>
    <cp>maximo\businessobjects.jar</cp>
  </classPath>
  <jre>
    <path>@JDK_HOME@</path>
    <bundledJre64Bit>false</bundledJre64Bit>
    <bundledJreAsFallback>false</bundledJreAsFallback>
    <minVersion>17</minVersion>
    <jdkPreference>preferJdk</jdkPreference>
  </jre>
</launch4jConfig>

































































































